{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "transit-pulse-recorder",
  "account_id": "2ecf50dd0473ff451ea98336863d40fc",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // No public URL: the recorder only runs on its schedule.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "r2_buckets": [{ "binding": "RAW", "bucket_name": "transit-pulse-raw" }],
  "observability": { "enabled": true }
}
